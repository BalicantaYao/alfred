# 從 LINE Developers Console 取得 (https://developers.line.biz/console/)
# Messaging API channel > Basic settings > Channel secret
LINE_CHANNEL_SECRET=your_channel_secret

# Messaging API channel > Messaging API > Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token

# 本機開發用,Railway 會自動注入 PORT
PORT=3000

# (選填) 啟用 LLM 自由格式解析,Claude 和 Gemini 擇一設定即可(兩個都沒設就只支援精確指令)
# Claude:從 https://platform.claude.com/ 取得
ANTHROPIC_API_KEY=your_anthropic_api_key
# Gemini:從 https://aistudio.google.com/ 免費取得
# GEMINI_API_KEY=your_gemini_api_key

# (選填) 兩個 key 都設定時,用 LLM_PROVIDER 指定要用哪個(claude 或 gemini,預設 claude)
# LLM_PROVIDER=gemini

# (選填) 解析用的模型
# ANTHROPIC_MODEL=claude-opus-4-8
# GEMINI_MODEL=gemini-3.5-flash

# (選填,正式環境建議) PostgreSQL 連線字串。沒設定時清單存在本機 data/shopping-lists.json
# Railway 上請在 Variables 設 DATABASE_URL = ${{Postgres.DATABASE_URL}}
# DATABASE_URL=postgres://user:password@host:5432/dbname

# (選填) 外部助理把提醒轉發到 LINE 的共享密鑰。沒設定時 POST /notify 會拒絕所有請求。
# 產生方式: openssl rand -hex 32
# NOTIFY_TOKEN=change-me

# (選填) 預設推送對象,LINE 的 user / group / room ID。
# 也可以在那個聊天輸入「訂閱轉發」,不必設這個變數。傳「我的ID」可以查到 ID。
# NOTIFY_LINE_TO=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (選填) 只有這個使用者 ID 可以訂閱或取消轉發。Bot 有加進群組時建議設定。
# 問助理的一對一也用這個 ID 判斷主人。沒設的話,任何一對一都視為主人。
# NOTIFY_OWNER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (選填) 外部助理的 HTTPS webhook。有設的話,群組裡點名 Alfred、或主人的一對一非指令訊息會 POST 過去。
# 必須是 https。助理收完應盡快回 2xx,之後用 POST /notify 把答案推回 replyTo。
# ASSISTANT_WEBHOOK_URL=https://assistant.example/alfred

# (選填,建議) 上面那個請求的 Authorization 標頭完整內容,原樣送出,不會再加 Bearer。
# 例如值是 "Bearer whsec_xxx",送出的標頭就是 Authorization: Bearer whsec_xxx
# ASSISTANT_WEBHOOK_AUTH=Bearer change-me

# (選填) 逗號分隔的使用者 ID。有設的話,只有這些人的訊息會轉發(群組點名也算)。
# ASSISTANT_ALLOWED_USER_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (選填) 逗號分隔的群組 ID。有設的話,只有這些群組裡的點名會轉發。一對一和聊天室不受這個限制。
# ASSISTANT_ALLOWED_GROUP_IDS=Cxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (選填) 轉發成功後用 reply token 回的確認句。預設:收到，我想一下 🤔
# 設成 false / off / 0 / no 就不要這句確認(失敗仍會回一句錯誤)。
# ASSISTANT_ACK=true
# ASSISTANT_ACK_TEXT=收到，我想一下 🤔

# (選填) 助理 webhook 失敗或逾時時回的短句。
# ASSISTANT_ERROR_TEXT=助理暫時連不上，請稍後再試

# (選填) 助理 webhook 逾時毫秒,預設 5000,範圍 100–20000。
# ASSISTANT_WEBHOOK_TIMEOUT_MS=5000

# (選填) 轉發前查 LINE 顯示名稱的上限毫秒,預設 400。設 0 就不查,displayName 只在 webhook 本來就有時才帶。
# ASSISTANT_PROFILE_TIMEOUT_MS=400

# (選填) Bot 自己的使用者 ID。標記資料有 isSelf 時不用設。沒有 isSelf 時用來辨認 mentionees.userId。
# LINE_BOT_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
