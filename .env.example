# 從 LINE Developers Console 取得 (https://developers.line.biz/console/)
# Messaging API channel > Basic settings > Channel secret
LINE_CHANNEL_SECRET=your_channel_secret

# Messaging API channel > Messaging API > Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token

# 本機開發用,Railway 會自動注入 PORT
PORT=3000

# (選填) 啟用 LLM 自由格式解析,Claude 和 Gemini 擇一設定即可(兩個都沒設就只支援精確指令)
# Claude:從 https://platform.claude.com/ 取得
ANTHROPIC_API_KEY=your_anthropic_api_key
# Gemini:從 https://aistudio.google.com/ 免費取得
# GEMINI_API_KEY=your_gemini_api_key

# (選填) 兩個 key 都設定時,用 LLM_PROVIDER 指定要用哪個(claude 或 gemini,預設 claude)
# LLM_PROVIDER=gemini

# (選填) 解析用的模型
# ANTHROPIC_MODEL=claude-opus-4-8
# GEMINI_MODEL=gemini-3.5-flash

# (選填,正式環境建議) PostgreSQL 連線字串。沒設定時清單與提醒存在本機 data/*.json
# Railway 上請在 Variables 設 DATABASE_URL = ${{Postgres.DATABASE_URL}}
# 多個 replica 要靠這顆資料庫的 job_runs 避免同一天重複推播
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- 每日行事曆提醒(選填;沒設定 Google 憑證時,訂閱指令仍可用,但不會推播) ---

# 設成 false / 0 / off 就停用排程。預設會啟動
# REMINDER_ENABLED=true

# 時區與預設推播時間(訂閱時沒寫時間就用這個)。預設 Asia/Taipei、08:00
# REMINDER_TIMEZONE=Asia/Taipei
# REMINDER_DEFAULT_TIME=08:00

# 錯過提醒時間後,還會補送幾分鐘。預設 180,不跨過午夜
# REMINDER_CATCHUP_MINUTES=180

# 標題以此前綴開頭的活動不列入。預設「出遊：」。設成空字串表示不略過
# CALENDAR_SKIP_TITLE_PREFIX=出遊：

# 日曆 ID。service account 請填你分享出去的那本日曆(通常是 Gmail),不要用 primary。
# 多本用逗號分隔
# GOOGLE_CALENDAR_ID=you@gmail.com

# 建議:service account JSON 金鑰。三選一,PATH 優先,其次 BASE64,再來是原始 JSON
# Railway 請用 BASE64,避免私鑰換行被吃掉
# GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/path/to/service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# GOOGLE_SERVICE_ACCOUNT_JSON=

# 替代:OAuth refresh token(scope 必須是 calendar.readonly)
# 同意畫面若在 Testing,refresh token 約 7 天失效,長期使用請改 service account
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
